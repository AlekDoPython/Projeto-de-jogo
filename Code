import pyxel

class Personagem:
    def __init__(self, x, y): # Inicializa o personagem com posição, dimensões e velocidade
        self.x = x
        self.y = y
        self.largura = 57
        self.altura = 24
        self.velocidade = 1   # Velocidade que o jogador se movimenta pela tela
        self.shots = []       # Lista para registrar múltiplos tiros
        self.shot_spd = 8     # Velocidade que o tiro viaja na tela
        self.shot_delay = 8   # Intervalo de cada disparo por update

    def mover(self): # Movimenta o personagem com as teclas WASD
        if pyxel.btn(pyxel.KEY_W):
            self.y -= self.velocidade
        if pyxel.btn(pyxel.KEY_A):
            self.x -= self.velocidade
        if pyxel.btn(pyxel.KEY_S):
            self.y += self.velocidade
        if pyxel.btn(pyxel.KEY_D):
            self.x += self.velocidade

        # Para o movimento do jogador se ele for sair da tela
        if self.x < 0:
            self.x = 0
        elif self.x > 420 - self.largura:
            self.x = 420 - self.largura
        if self.y < 0:
            self.y = 0
        elif self.y > 219 - self.altura:
            self.y = 219 - self.altura

        self.shot_delay -= 1
        if self.shot_delay == 0: # Valor para permitir o próximo tiro
            if pyxel.btnp(pyxel.KEY_SPACE, 0, 1):
                Nshot = {"x": self.x + self.largura - 18, "y": self.y + 4}
                self.shots.append(Nshot)
            self.shot_delay = 8 # Retorna o valor original para os próximos tiros
        for shot in self.shots[:]:
            shot["x"] += self.shot_spd
            if shot["x"] > 420:
                self.shots.remove(shot)
    def draw(self, hp): # Desenha o personagem com suas respectivas dimenções
        if hp > 1:
            pyxel.blt(self.x, self.y, 0, 0, 0, self.largura, self.altura, colkey = 12)
        elif hp == 1:
            pyxel.blt(self.x, self.y, 0, 57, 0, self.largura, self.altura, colkey = 12)
        else:
            pyxel.blt(self.x + 10, self.y - 5, 0, 114, 0, 50, 50, colkey = 12)
        for shot in self.shots:
            pyxel.rect(shot["x"], shot["y"], 2, 1, 10)

class Cenario:              # Classe para o cenário de fundo com a velocidade que ele se move
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.largura = 210
        self.altura = 20
        self.velocidade = 1 # Quantidade de pixels que o cenário se move por update
        self.delay = 0      # Valor de updates para movimentar o cenário
       
    def draw(self):                                                          # Desenha os sprites do fundo
        pyxel.blt(self.x, self.y, 1, 0, 0, self.largura, self.altura)        # Desenha a primeira metade
        pyxel.blt(self.x + 210, self.y, 1, 0, 20, self.largura, self.altura) # Desenha a segunda metade
        pyxel.blt(self.x + 420, self.y, 1, 0, 0, self.largura, self.altura)  # Cópia da primeira metade para a criação do looping
        pyxel.blt(self.x + 630, self.y, 1, 0, 20, self.largura, self.altura) # Cópia da segunda metade para a criação do looping

    def mover(self):          # Movimenta o cenário de fundo
        if self.delay == 0:   # Valor especificado para movimentar o cenário
            self.x -= self.velocidade
            self.delay += 1
        elif self.delay <15:  # Aumenta o valor do delay para gerar o atraso
            self.delay += 1
        elif self.delay ==15: # Reseta o valor para movimentar o cenário novamente
            self.delay = 0
        if self.x <= -420:    # Faz a metade do cenário que saiu da tela voltar para o outro lado criando o looping
            self.x = 0

class enemy:
    def __init__(self):                   # Inicializa o inimigo com posição, dimensões e velocidade
        import random                     # Importa a função random para gerar os números
        self.x = 500                      # Faz o inimigo aparecer em um distância fora da tela
        self.y = random.randint(5, 190)   # Faz o inimigo aparecer em uma altura aleatória respeitando o limite de altura do jogador
        self.largura = 54
        self.altura = 24
        self.velocidade = 1
        self.hp = 10                      # Quantidade de tiros que o inimigo pode sofrer antes de morrer
        self.alive = True                 # Verifica se o inimigo está vivo

    def mover(self):                  # Movimento do inimigo
        if self.alive:
            self.x -= self.velocidade # Movimenta o inimigo de forma constante

    def draw(self):
        if self.alive == True: # Desenha o personagem se ele estiver vivo
            if self.hp > 5:
                pyxel.blt(self.x, self.y, 0, 0, 24, self.largura, self.altura, colkey = 12)
            else:
                pyxel.blt(self.x, self.y, 0, 54, 24, self.largura, self.altura, colkey = 12)

class Jogo:                                                # Classe principal do jogo
    def __init__(self):                                    # Inicializa a janela e carrega os recursos
        import random
        pyxel.init(420, 219, fps=30, title="Aero Shield")  # Tela de 420x219, 30 FPS
        pyxel.image(0).load(0, 0, "planes_164x88.png")      # Carrega os sprites do personagem
        pyxel.image(1).load(0, 0, "background_210x40.png") # Carrega os sprites do fundo
        self.boom = []                                     # Lista que armazena todas as animações de explosão
        self.score = 0                                     # Pontuação inicial
        self.tutorial = 180                                # Tempo que a mensagem de tutorial fica na tela (6 segundos)
        self.game_over = False
        self.game_win = False
        self.win_delay = 60                                # Intervalo de tempo antes de mostrar a tela de vitória
        self.enemies = []                                  # Lista que armazena todos os inimigos gerados
        self.goal = random.randint(15, 25)                 # Número de inimigos que vão aparecer na partida
        self.goal_count = 0                                # Contador de abates
        self.damage = 0                                    # Dano que a base recebeu
        self.spawn_delay = 0
        self.spawn_random = random.randint(60, 160)        # Gera um valor aleatório de updates para definir o spawn do próximo inimigo
        self.Personagem = Personagem(1, 20)                # Cria o personagem do jogo na posição (1, 20)
        self.enemy = enemy()                               # Cria o inimigo
        self.Cenario = Cenario(0, 200)                     # Cria o cenário na posição (0, 200)
        self.hpP = 3                                       # Quantidade de danos que o jogador pode tomar dano antes de perder
        self.hpB = 3                                       # Quantidade de danos que a base pode tomar antes de ser destruida (se o inimigo passar para o outro lado da tela)
        if self.enemy.hp <= 0:
            self.enemy.alive = False
            booms = {"x": self.enemy.x, "y": self.enemy.y, "frame": 0, "tempo": 0}
            self.boom.append(booms)
        pyxel.run(self.update, self.draw)                  # Inicia o loop principal do jogo

    def update(self):                                # Atualiza o estado do jogo
        import random
        self.tutorial -= 1
        if self.game_over or self.game_win:                           
            if pyxel.btnp(pyxel.KEY_R):              
                self.reset()                         # Reinicia o jogo se o jogador apertar R na tela de game over
            return
        self.Personagem.mover()
        self.enemy.mover()
        self.Cenario.mover()

        if (self.hpP <= 0) or (self.hpB <= 0):                      # Ativa o game over se o jogador ou a base perder toda a vida
            self.game_over = True
        if self.goal_count >= self.goal and len(self.enemies) == 0: # Ativa a vitória se o jogar matar todos os inimigos
            self.win_delay -= 1
            if self.win_delay <= 0:
                self.game_win = True
                self.score += 500                                   # Bonus por vencer a partida
                if self.hpP == 3:                               
                    self.score += 250                               # Bonus por vencer sem tomar dano
                if self.hpB == 3:
                    self.score += 250                               # Bonus por proteger a cidade perfeitamente


        if self.goal_count < self.goal:
            self.spawn_delay += 1
        if self.spawn_delay >= self.spawn_random:    # Intervalo aleatório para o próximo inimigo aparecer jogador
            self.spawn_delay = 0
            self.enemies.append(enemy())
            self.goal_count += 1                     # Adiciona o novo inimigo no contador até chegar na quantidade aleatória escolhida
            self.spawn_random = random.randint(60, 160)

        for e in self.enemies[:]:
            e.mover()
            if e.x < -100: # Se o inimigo passar pro outro lado, causa dano a base
                self.enemies.remove(e)
                self.hpB -= 1
                self.damage += 1
                self.score -= 25

        for e in self.enemies[:]:
            if e.alive and self.colide(self.Personagem, e):
                self.hpP -= 1
                self.score -= 25
                e.alive = False
                self.enemies.remove(e)
                Nboom = {"x": e.x + 10, "y": e.y - 5, "frame": 0, "time": 0} # Cria explosão se o jogador colidir no inimigo
                self.boom.append(Nboom)

        for e in self.enemies[:]:
            if e.alive:
                for shot in self.Personagem.shots[:]:
                    if (shot["x"] < e.x + e.largura and shot["x"] + 2 > e.x and shot["y"] < e.y + e.altura and shot["y"] + 1 > e.y):
                        e.hp -= 1
                        self.score += 5
                        self.Personagem.shots.remove(shot)
                        if e.hp <= 0:
                            e.alive = False
                            self.score += 100
                            Nboom = {"x": e.x, "y": e.y, "frame": 0, "time": 0}
                            self.boom.append(Nboom)
                            self.enemies.remove(e)
                            break

        for booms in self.boom[:]:
            booms["time"] += 1
            if booms["time"] >= 8:          # Velocidade que cada frame aparece
                booms["time"] = 0
                booms["frame"] += 1
                
                if booms["frame"] >= 3: 
                    self.boom.remove(booms) # Apaga a explosão quando o último frame aparecer

    def colide(self, P, E):
        return (P.x < E.x + E.largura and P.x + P.largura > E.x and P.y < E.y + E.altura and P.y + P.altura > E.y) # Verifica colisão entre o jogador e o inimigo

    def reset(self): # Reseta o jogo pro estado inicial quando for chamado
        import random
        self.hpP = 3
        self.hpB = 3
        self.game_over = False
        self.game_win = False
        self.win_delay = 60
        self.goal = random.randint(15, 30)
        self.goal_count = 0
        self.damage = 0
        self.score = 0
        self.Personagem = Personagem(1, 20)
        self.enemy = enemy()
        self.boom = []
        self.enemies = []


    def draw(self):                                       # Desenha os elementos na tela
        pyxel.cls(12)                                     # Limpa a tela com a cor de fundo
        self.Cenario.draw()
        if self.tutorial >= 0:
            pyxel.text(160, 100, "Segure space para atirar", 7)
        if not (self.game_over or self.game_win):
            pyxel.text(360, 2, f"Score: {self.score}", 7) # Desenha o score no canto da tela até acabar a partida
        pyxel.text(2, 2, f"HP: {self.hpP}", 8)            # Desenha o contador de hp do jogador
        pyxel.text(2, 10, f"City HP: {self.hpB}", 9)      # Desenha o contador de hp da base
        for e in self.enemies:                            # Desenha todos os inimigos da lista
            e.draw()
        self.Personagem.draw(self.hpP)
        for booms in self.boom:
            u_frame = booms["frame"] * 40 
            pyxel.blt(booms["x"], booms["y"], 0, u_frame, 48, 40, 40, colkey=12)
        if self.game_over:
            pyxel.text(180, 100, "GAME OVER", 8)
            if self.hpP == 0:
                pyxel.text(172, 110, "Voce EXPLODIU", 2)
            else:
                pyxel.text(137, 110, "Voce falhou em proteger a cidade", 2)
            pyxel.text(178, 120, f"Score: {self.score}", 14)
            pyxel.text(153, 145, "Aperte R para reiniciar", 7)
        if self.game_win:
            pyxel.text(180, 60, "VITORIA", 10)
            pyxel.text(115, 70, "Parabens, voce conseguiu proteger a cidade!", 9)
            pyxel.text(165, 90, f"Score total: {self.score}", 15)
            pyxel.text(155, 100, f"Inimigos abatidos: {self.goal_count - self.damage}", 15)
            pyxel.text(150, 120, "Aperte R para reiniciar", 7)

Jogo() # Inicializa o jogo
